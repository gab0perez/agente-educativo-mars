# Google Gemini API Key (Backend Only)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Puerto del Servidor
PORT=3000

# Google Classroom OAuth 2.0 (Backend Only)
# Obtén estas credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:3000/api/auth/google-classroom/callback

# Clave secreta para cifrado de tokens en el servidor (Opcional, 32 caracteres)
ENCRYPTION_SECRET=mar_secret_encryption_key_2026_xyz
